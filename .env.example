# Application
PROJECT_NAME=Novel Engine
PROJECT_VERSION=0.1.0
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# AI provider (optional for non-AI workflows)
OPENAI_API_KEY=
AI_MODEL=gpt-4o
# OpenAI-compatible provider label and optional base URL (e.g. OpenRouter/Ollama).
AI_PROVIDER=openai
AI_BASE_URL=
# Whether the model above can see pictures, and its limits (CTX-013). Off by default: the route
# is text only, so a picture is given as its accepted description, or work that needs the
# picture itself is refused before anything is spent.
AI_IMAGE_INPUT=false
AI_IMAGE_MAX_COUNT=4
AI_IMAGE_MAX_BYTES=5242880
AI_IMAGE_TYPES=image/png,image/jpeg,image/webp
# Hosted: providers whose chosen models a workspace's own key may send pictures to, by id
# (e.g. "openrouter,anthropic"). Empty means none.
AI_IMAGE_PROVIDERS=
# What each model can take (CTX-013), as JSON keyed by "provider/model" ("*" at the end
# matches the rest of a name); it wins over the provider's own list. Example:
# AI_MODEL_CAPABILITIES={"openrouter/deepseek/*": {"images": false}, "openai/gpt-4o": {"context_tokens": 128000}}
AI_MODEL_CAPABILITIES=
# Read OpenRouter's public model list (no story words go with it) at most once a day.
AI_MODEL_LIST=true
# Drafts shown in the studio as they are written (SCN-002).
AI_STREAMING=true

# Neo4j (matches docker-compose.yml defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# PostgreSQL + pgvector (matches docker-compose.yml defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=novel
POSTGRES_PASSWORD=postgres
POSTGRES_DB=novel_engine
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30

# Embeddings and derived local data
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# minilm | embeddinggemma | api | fake | none. Changing it needs `make reindex` then
# `make reindex-activate`; until then search by meaning is off (health says why).
EMBEDDING_PROVIDER=minilm
# EMBEDDING_PROVIDER=api: an OpenAI-compatible embeddings service, so no model runs on this
# server. Every passage is sent to it in the background; authors are told so on the Assistant
# page. https unless it is on this machine (Ollama: http://localhost:11434/v1, no key needed).
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
# A secret: keep it out of git (or mount it as a secret file named embedding_api_key).
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-small
# At most 2000. Sent as "dimensions" so the service shortens its vectors; turn that off for a
# service that refuses the field, and set its own size here.
EMBEDDING_API_DIMENSION=1536
EMBEDDING_API_SEND_DIMENSION=true
# The name authors see for where their writing goes (e.g. OpenAI); the host if empty.
EMBEDDING_API_NAME=
EMBEDDING_GEMMA_MODEL=google/embeddinggemma-2
# Pin an exact model commit before using embeddinggemma.
EMBEDDING_GEMMA_REVISION=
EMBEDDING_GEMMA_DIMENSION=512
EMBEDDING_DTYPE=auto
EMBEDDING_FAKE_DIMENSION=768
# Catch the search index up in the background every N minutes (0 = off; make reindex-refresh).
SEARCH_INDEX_CATCH_UP_MINUTES=0
CUSTOM_SCHEMA_PATH=backend/config/custom_schema.json

# Optional development artifacts (disable outside development)
ENABLE_DEBUG_ARTIFACTS=false
ARTIFACT_STORE_DIR=backend/debug
OBJECT_STORE_DIR=data/objects
# Picture preparation (thumbnails and 1024px copies), decoded in a separate limited process.
MEDIA_PROCESSING_ENABLED=true
# Ceilings checked from a picture's header before it is decoded (decompression-bomb guard).
MEDIA_MAX_PIXELS=40000000
MEDIA_MAX_DIMENSION=12000
# The decoder process's memory and CPU limits, and how long to wait for it.
MEDIA_WORKER_MEMORY_BYTES=1073741824
MEDIA_WORKER_CPU_SECONDS=20
MEDIA_WORKER_TIMEOUT_SECONDS=30
# The decoder's sandbox beyond those limits (no new privileges, its own network, Landlock,
# seccomp): best = what this machine allows, require = prepare no picture without Landlock and
# seccomp, off = none. Reported in /health/capabilities; see plan/runbooks/media-processing.md.
MEDIA_WORKER_SANDBOX=best
MEDIA_WORKER_CONCURRENCY=2
# Room for each workspace's pictures and their copies; 0 means no limit.
MEDIA_WORKSPACE_QUOTA_BYTES=2147483648
# Stored files no picture refers to are removed by retention only after this many hours.
MEDIA_ORPHAN_GRACE_HOURS=24

# Error monitoring (optional; an empty DSN disables that side). Content is scrubbed before sending.
# The server reports to SENTRY_DSN_BACKEND. It hands SENTRY_DSN_WEB to the page it serves, so the
# browser needs no build-time setting. On the hosted site both come from secret files instead
# (deploy/hosted/secrets/sentry_dsn_backend and sentry_dsn_web); leave these empty there.
SENTRY_DSN_BACKEND=
SENTRY_DSN_WEB=
# 0.0 = errors only; raise to sample performance traces
SENTRY_TRACES_SAMPLE_RATE=0.0
# What is running, for tracing an error to a deploy. The hosted site sets it to the image tag.
APP_RELEASE=
# Operational metrics in Prometheus text format at /health/metrics (counts and
# timings only; never ids or story content). Set a token outside local
# development: production refuses to serve metrics without one.
METRICS_ENABLED=false
METRICS_TOKEN=

# Authentication: "local" is the trusted self-hosted single-user mode; "hosted" uses OIDC.
AUTH_MODE=local
AUTH_LOCAL_USER_ID=local-user
AUTH_LOCAL_WORKSPACE_ID=local-workspace
AUTH_LOCAL_PROJECT_ID=local-project

# OIDC identity (Authentik). Required for AUTH_MODE=hosted; leave empty for local mode.
# The issuer is exact and includes the trailing slash; the redirect URI must exactly match
# a URI registered on the provider (no wildcards).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid profile email

# Application session cookies. Secure is forced in hosted/production; 1209600s = 14 days.
SESSION_COOKIE_NAME=novel_session
SESSION_TTL_SECONDS=1209600
SESSION_ROTATION_SECONDS=3600
CSRF_COOKIE_NAME=novel_csrf

# Platform authority (global schema, workspace provisioning). Local mode is always admin.
PLATFORM_ADMIN_USER_IDS=
# Hosted workspaces are invitation-gated; only platform admins may create one unless enabled.
ALLOW_WORKSPACE_SELF_CREATION=false
# A signed-in person who owns no workspace may create a personal one. Who may sign in at all is
# decided by the identity provider.
ALLOW_PERSONAL_WORKSPACE=true

# Provider credentials and usage limits (hosted BYOK).
# Generate a KEK with: python -c "from backend.core.crypto import generate_kek; print(generate_kek())"
# An empty KEK disables credential storage.
CREDENTIAL_KEK=
CREDENTIAL_KEK_VERSION=1
# Retired KEKs for decrypting existing credentials after rotation, e.g. "1:<old-kek>"
CREDENTIAL_PREVIOUS_KEKS=
PROVIDER_PER_JOB_TOKEN_LIMIT=200000
PROVIDER_PER_JOB_COST_LIMIT=0
PROVIDER_PERIOD_TOKEN_LIMIT=2000000
PROVIDER_PERIOD_COST_LIMIT=0
PROVIDER_PERIOD_SECONDS=86400
# How long a request may run on an author's own computer, through the connector, before
# the site stops waiting (SCN-002A, plan/runbooks/local-connector.md).
CONNECTOR_ANSWER_SECONDS=600

# --- Hosted deployment (deploy/hosted) ---
# Directory of the built frontend; when set, the API also serves the web UI.
FRONTEND_DIST_DIR=
# Interactive API docs and /openapi.json. Empty = served only by a local, non-production instance.
# API_DOCS_ENABLED=false
# NOVEL_ENGINE_SECRETS_DIR (process environment only, not read from this file): a directory of
# files named after settings (postgres_password, oidc_client_secret, ...), e.g. /run/secrets.
