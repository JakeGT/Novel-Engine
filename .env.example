# Application
PROJECT_NAME=Novel Engine
PROJECT_VERSION=0.1.0
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# AI provider (optional for non-AI workflows)
OPENAI_API_KEY=
AI_MODEL=gpt-4o

# Neo4j (matches docker-compose.yml defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# PostgreSQL + pgvector (matches docker-compose.yml defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=novel
POSTGRES_PASSWORD=postgres
POSTGRES_DB=novel_engine
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30

# Embeddings and derived local data
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CUSTOM_SCHEMA_PATH=backend/config/custom_schema.json

# Optional development artifacts (disable outside development)
ENABLE_DEBUG_ARTIFACTS=false
ARTIFACT_STORE_DIR=backend/debug

# Error monitoring (optional; an empty backend DSN disables it). Content is scrubbed before sending.
SENTRY_DSN_BACKEND=
SENTRY_DSN_WEB=
# The web client reads VITE_SENTRY_DSN_WEB from frontend/.env, not this file.
# 0.0 = errors only; raise to sample performance traces
SENTRY_TRACES_SAMPLE_RATE=0.0

# Authentication: "local" is the trusted self-hosted single-user mode; "hosted" uses OIDC.
AUTH_MODE=local
AUTH_LOCAL_USER_ID=local-user
AUTH_LOCAL_WORKSPACE_ID=local-workspace

# OIDC identity (Authentik). Required for AUTH_MODE=hosted; leave empty for local mode.
# The issuer is exact and includes the trailing slash; the redirect URI must exactly match
# a URI registered on the provider (no wildcards).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid profile email

# Application session cookies. Secure is forced in hosted/production; 1209600s = 14 days.
SESSION_COOKIE_NAME=novel_session
SESSION_TTL_SECONDS=1209600
CSRF_COOKIE_NAME=novel_csrf
